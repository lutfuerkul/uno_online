rules_version = '2';

// Kimlik: uygulama açılışta Firebase'e anonim oturum açar ve oyuncu kimliği
// (odanın `players` listesindeki değer) bu oturumun UID'sidir
// (bkz. lib/services/player_identity.dart). Kurallar da yetkiyi buna
// dayandırır: bir odayı yalnızca o odadaki oyuncular değiştirebilir.
//
// ÖNEMLİ — bu kuralları deploy etmeden önce Firebase Console'da
// Authentication > Sign-in method altında **Anonymous** sağlayıcısı açık
// olmalı. Açık değilse istemci oturum açamaz ve tüm online işlemler
// permission-denied ile reddedilir.
//
// Ek katman olarak odalar silinemez ve her yazma, uygulamanın ürettiği belge
// şekliyle (beklenen alanlar + tipler) eşleşmek zorundadır.
service cloud.firestore {
  match /databases/{database}/documents {

    // Odayı kuran kişi kendini tek oyuncu olarak eklemek zorunda; başkasının
    // adına oda açılamaz.
    function isCreator(d) {
      return request.auth != null
             && d.players.size() == 1
             && d.players[0] == request.auth.uid;
    }

    // Yazma yetkisi iki durumda var:
    //  1) İstek sahibi zaten odadaki bir oyuncu (hamle, çıkma, rövanş...).
    //  2) Bekleme odasındaki bir odaya kendini ekleyen yeni oyuncu — bu
    //     sırada mevcut oyunculardan hiçbirini listeden çıkaramaz.
    function canWrite() {
      // `resource != null`: belge yoksa geçerli olan bu kural değil `create`
      // kuralıdır. Savunma amaçlı bir kontrol — var olmayan belgede
      // `resource.data` okumaya çalışmayı engeller.
      return request.auth != null && resource != null && (
        request.auth.uid in resource.data.players
        || (resource.data.status == 'waiting'
            && request.auth.uid in request.resource.data.players
            && resource.data.players.hasOnly(request.resource.data.players))
      );
    }

    match /games/{gameId} {
      allow read: if request.auth != null;
      allow delete: if false;
      allow create: if gameId.matches('^[A-Z0-9]{5}$') && isValidUnoGame(request.resource.data)
                    && isCreator(request.resource.data)
                    && request.resource.data.status == 'waiting';
      allow update: if canWrite() && isValidUnoGame(request.resource.data);
    }

    match /pisti_games/{gameId} {
      allow read: if request.auth != null;
      allow delete: if false;
      allow create: if gameId.matches('^[A-Z0-9]{5}$') && isValidPistiGame(request.resource.data)
                     && isCreator(request.resource.data)
                     && request.resource.data.status == 'waiting';
      allow update: if canWrite() && isValidPistiGame(request.resource.data);
    }

    match /okey_games/{gameId} {
      allow read: if request.auth != null;
      allow delete: if false;
      allow create: if gameId.matches('^[A-Z0-9]{5}$') && isValidOkeyGame(request.resource.data)
                     && isCreator(request.resource.data)
                     && request.resource.data.status == 'waiting';
      allow update: if canWrite() && isValidOkeyGame(request.resource.data);
    }

    function isValidUnoGame(d) {
      return d.keys().hasOnly([
        'status', 'players', 'playerNames', 'playerPhotos', 'hands', 'drawPile',
        'discardPile', 'currentColor', 'currentTurn', 'direction', 'hasDrawn',
        'unoSafe', 'reverseColor', 'blockedPlayers', 'winner', 'lastAction',
        'createdAt'
      ])
      && d.status is string
      && d.players is list && d.players.size() <= 4
      && d.playerNames is map
      && d.playerPhotos is map
      && d.hands is map
      && d.drawPile is list
      && d.discardPile is list
      && d.currentColor is string
      && d.currentTurn is string
      && d.direction is number
      && d.hasDrawn is bool
      && d.unoSafe is list
      && d.blockedPlayers is list
      && d.createdAt is number;
    }

    function isValidOkeyGame(d) {
      return d.keys().hasOnly([
        'status', 'players', 'playerNames', 'playerPhotos', 'hands', 'drawPile',
        'discards', 'indicator', 'currentTurn', 'hasDrawn', 'drawnFromDiscardId',
        'lastAction', 'winner', 'winners', 'finishedByOkey', 'finishedByPair',
        'scores', 'cumulativeScores', 'createdAt'
      ])
      && d.status is string
      && d.players is list && d.players.size() <= 4
      && d.playerNames is map
      && d.playerPhotos is map
      && d.hands is map
      && d.drawPile is list
      && d.discards is map
      && d.currentTurn is string
      && d.hasDrawn is bool
      && d.winners is list
      && d.scores is map
      && d.cumulativeScores is map
      && d.createdAt is number;
    }

    function isValidPistiGame(d) {
      return d.keys().hasOnly([
        'status', 'players', 'playerNames', 'playerPhotos', 'hands', 'pile',
        'drawPile', 'won', 'pistiCount', 'jackPistiCount', 'lastCapturer',
        'lastAction', 'pendingCapture', 'currentTurn', 'winner', 'winners',
        'scores', 'scoreDetail', 'createdAt', 'skipResultDelay'
      ])
      && d.status is string
      && d.players is list && d.players.size() <= 4
      && d.playerNames is map
      && d.playerPhotos is map
      && d.hands is map
      && d.pile is list
      && d.drawPile is list
      && d.won is map
      && d.pistiCount is map
      && d.currentTurn is string
      && d.winners is list
      && d.scores is map
      && d.scoreDetail is map
      && d.createdAt is number;
    }
  }
}
